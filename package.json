{
  "name": "pipeup",
  "version": "1.0.0",
  "description": "A no-login, real-time party game for teams.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node lib/rooms.test.js"
  },
  "nodemonConfig": {
    "watch": ["server.js", "lib"],
    "ext": "js,json"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
